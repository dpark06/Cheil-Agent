# Copy this file to .env and fill in real values before running the app.
# Never commit .env with real secrets.

# --- Application ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Postgres). Start one locally with: docker compose up -d ---
DATABASE_URL=postgresql://cheil_delta:cheil_delta_dev@localhost:5432/cheil_delta

# --- Auth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Encryption for temp files at rest (optional but recommended) ---
# 32-byte hex key. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Cron catch-up sweep (only needed on a serverless deploy with no
# long-running worker.ts process — see docs/known-gaps.md "Serverless
# deployment" and src/app/api/cron/process-jobs/route.ts). Not needed for
# local dev, where worker.ts handles everything. Generate the same way as
# AUTH_SECRET; must match whatever the external scheduler (this repo's own
# .github/workflows/process-jobs-cron.yml) sends.
CRON_SECRET=

# --- AI provider ---
# AI_PROVIDER=mock runs fully offline with deterministic canned output — no key needed.
# The mock has no real image understanding at all. For real vision (identifying and
# comparing actual image content), pick one:
# AI_PROVIDER=openai requires AI_API_KEY (paid). AI_MODEL example: gpt-4o-mini.
# AI_PROVIDER=anthropic requires AI_API_KEY (paid). AI_MODEL example: claude-sonnet-4-5-20250929
#   (verify the current model id against docs.anthropic.com/en/docs/about-claude/models
#   before relying on this — model ids are periodically retired).
# AI_PROVIDER=ollama runs against a local Ollama instance — no key, no billing, but
#   noticeably lower output quality/reliability than the paid providers above (see
#   docs/known-gaps.md). Requires `ollama serve` running and a vision model pulled,
#   e.g. `ollama pull llava`. AI_MODEL example: llava. Set OLLAMA_BASE_URL if Ollama
#   isn't on the default http://localhost:11434.
# AI_PROVIDER=fallback tries multiple providers in order and uses the first one that
#   actually responds — e.g. Claude first, OpenAI if Claude's API errors or is down.
#   This is availability failover, not a quality vote (only one provider is ever
#   billed per call — whichever succeeds first). Configure AI_FALLBACK_ORDER as a
#   comma-separated list (default "anthropic,openai") and set each provider's own
#   key/model — ANTHROPIC_API_KEY/ANTHROPIC_MODEL, OPENAI_API_KEY/OPENAI_MODEL —
#   instead of the generic AI_API_KEY/AI_MODEL, since both need to be usable at once.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Only used when AI_PROVIDER=fallback (or when a specific provider needs a distinct
# key/model from whatever AI_API_KEY/AI_MODEL are set to):
AI_FALLBACK_ORDER=anthropic,openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email provider (used for password reset) ---
# EMAIL_PROVIDER=console runs fully offline — reset links are logged to the
# server console instead of emailed, no SMTP account needed.
# EMAIL_PROVIDER=smtp requires SMTP_HOST/PORT/USER/PASSWORD/FROM below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Local temp file storage ---
STORAGE_ROOT=./storage

# --- Limits (see docs/known-gaps.md for rationale) ---
FILE_RETENTION_HOURS=24
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_COMPARISON=10
MAX_PDF_PAGES=100
MAX_AI_COST_CENTS_PER_SESSION=200
MAX_UPLOADS_PER_HOUR=20
